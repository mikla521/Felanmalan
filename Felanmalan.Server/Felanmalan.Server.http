@Felanmalan.Server_HostAddress = http://localhost:5145

# Skapa en felanmälan (#35). Sparar ett ärende i den lokala databasen.
# Förväntat svar: 201 med det sparade ärendet och dess Id.
POST {{Felanmalan.Server_HostAddress}}/api/felanmalan
Content-Type: application/json
Accept: application/json

{
  "description": "Skärmen startar inte i sal 204.",
  "category": "Hardware"
}

###

# Tom beskrivning: förväntat 400.
POST {{Felanmalan.Server_HostAddress}}/api/felanmalan
Content-Type: application/json

{
  "description": "   ",
  "category": "Hardware"
}

###

# Saknad kategori: förväntat 400, ska inte automatiskt bli Hardware.
POST {{Felanmalan.Server_HostAddress}}/api/felanmalan
Content-Type: application/json

{
  "description": "Skärmen startar inte."
}

###

# Okänd kategori: förväntat 400.
POST {{Felanmalan.Server_HostAddress}}/api/felanmalan
Content-Type: application/json

{
  "description": "Skärmen startar inte.",
  "category": "Unknown"
}

###


# Testa login med rätt uppgifter.
POST {{Felanmalan.Server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@felanmalan.se",
  "password": "demo123"
}

###

# Ska bara fungera när användaren är autentiserad.
GET {{Felanmalan.Server_HostAddress}}/api/auth/me
Accept: application/json

###
# Fel lösenord: förväntat 401.
POST {{Felanmalan.Server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@felanmalan.se",
  "password": "fel"
}

###

###

# Logga ut
POST {{Felanmalan.Server_HostAddress}}/api/auth/logout

###

# Ska nu ge 401 eftersom användaren är utloggad.
GET {{Felanmalan.Server_HostAddress}}/api/auth/me
Accept: application/json

###

###
# US11.4 - Testa inloggning

# 1. Rätt inloggningsuppgifter: förväntat 200.
POST {{Felanmalan.Server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@felanmalan.se",
  "password": "demo123"
}

###

# 2. Autentiserad användare: förväntat 200 och användarens identitet.
GET {{Felanmalan.Server_HostAddress}}/api/auth/me
Accept: application/json

###

# 3. Logga ut.
POST {{Felanmalan.Server_HostAddress}}/api/auth/logout

###

# 4. /me utan autentisering: förväntat 401.
GET {{Felanmalan.Server_HostAddress}}/api/auth/me
Accept: application/json

###

# 5. Skyddad funktion utan autentisering: förväntat 401.
POST {{Felanmalan.Server_HostAddress}}/api/felanmalan
Content-Type: application/json
Accept: application/json

{
  "description": "Test utan inloggning"
}

###

# 6. Fel lösenord: förväntat 401.
POST {{Felanmalan.Server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo@felanmalan.se",
  "password": "fel"
}

###